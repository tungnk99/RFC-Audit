requirement SSH-0002 from RFC4253§7.1#p8s1 modal MUST type B
actor server
state version_exchanged
# Đoạn 8 của mục 7.1 nói về kex_algorithms: không có thuật toán kex chung thì cả hai bên phải ngắt kết nối.
trigger receive(kexinit) where kexinit.common_kex_count < 1
expect close within 2000ms
forbid send(newkeys)
variants boundary(kexinit.common_kex_count, 0), valid_random(kexinit.common_kex_count, k=3)
